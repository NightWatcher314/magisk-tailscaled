#!/system/bin/sh
set -e
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=tailscale/settings.sh
. "$DIR"/../settings.sh

quote_value() {
  escaped=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
  printf "'%s'" "$escaped"
}

write_config() {
  umask 077
  tmp="${TS_CONFIG_FILE}.tmp.$$"
  mkdir -p "$(dirname "$TS_CONFIG_FILE")"
  {
    echo "# Magisk Tailscaled runtime configuration"
    echo "# Edit with tailscaled.config or the WebUI. Values are shell-quoted."
    echo "TS_START_ON_BOOT=$(quote_value "${TS_START_ON_BOOT:-1}")"
    echo "TS_DAEMON_ARGS=$(quote_value "${TS_DAEMON_ARGS:--no-logs-no-support}")"
    echo "TS_UP_ARGS=$(quote_value "${TS_UP_ARGS:---accept-dns=false}")"
    echo "TS_LOGIN_SERVER=$(quote_value "${TS_LOGIN_SERVER:-}")"
    echo "TS_HOSTNAME=$(quote_value "${TS_HOSTNAME:-}")"
    echo "TS_ENABLE_SSH=$(quote_value "${TS_ENABLE_SSH:-0}")"
    echo "TS_EXTRA_UP_ARGS=$(quote_value "${TS_EXTRA_UP_ARGS:-}")"
    echo "TS_WATCHDOG_ENABLED=$(quote_value "${TS_WATCHDOG_ENABLED:-0}")"
    echo "TS_LOG_MAX_KB=$(quote_value "${TS_LOG_MAX_KB:-1024}")"
  } >"$tmp"
  mv -f "$tmp" "$TS_CONFIG_FILE"
  chmod 0600 "$TS_CONFIG_FILE" 2>/dev/null || true
}

normalize_login_server() {
  value=$(printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s#/*$##')
  [ -z "$value" ] && { printf '\n'; return 0; }
  validate_arg_value "$value"
  case "$value" in *[[:space:]?\#@]*) echo "TS_LOGIN_SERVER must be a plain http(s) origin URL" >&2; return 1;; esac
  case "$value" in
    http://*|https://*) ;;
    *) value="https://${value}" ;;
  esac
  authority=${value#*://}
  [ -n "$authority" ] || { echo "TS_LOGIN_SERVER hostname is required" >&2; return 1; }
  case "$authority" in */*) echo "TS_LOGIN_SERVER must not contain a path" >&2; return 1;; esac
  printf '%s\n' "$value"
}

show_json() {
  jq -cn \
    --arg startOnBoot "${TS_START_ON_BOOT:-1}" \
    --arg daemonArgs "${TS_DAEMON_ARGS:-}" \
    --arg upArgs "${TS_UP_ARGS:-}" \
    --arg loginServer "${TS_LOGIN_SERVER:-}" \
    --arg hostname "${TS_HOSTNAME:-}" \
    --arg enableSsh "${TS_ENABLE_SSH:-0}" \
    --arg extraUpArgs "${TS_EXTRA_UP_ARGS:-}" \
    --arg watchdogEnabled "${TS_WATCHDOG_ENABLED:-0}" \
    --arg logMaxKb "${TS_LOG_MAX_KB:-1024}" \
    '{startOnBoot:$startOnBoot,daemonArgs:$daemonArgs,upArgs:$upArgs,loginServer:$loginServer,hostname:$hostname,enableSsh:$enableSsh,extraUpArgs:$extraUpArgs,watchdogEnabled:$watchdogEnabled,logMaxKb:$logMaxKb}'
}

validate_key() {
  case "$1" in
    TS_START_ON_BOOT|TS_DAEMON_ARGS|TS_UP_ARGS|TS_LOGIN_SERVER|TS_HOSTNAME|TS_ENABLE_SSH|TS_EXTRA_UP_ARGS|TS_WATCHDOG_ENABLED|TS_LOG_MAX_KB) return 0 ;;
  esac
  echo "Unsupported key: $1" >&2
  return 1
}

validate_arg_value() {
  # shellcheck disable=SC1003
  case "$1" in
    *"'"*|*'"'*|*";"*|*"|"*|*"&"*|*'$'*|*'('*|*')'*|*'`'*|*'<'*|*'>'*|*'\\'*)
      echo "Unsafe shell characters in argument value" >&2
      return 1
    ;;
  esac
  clean=$(printf '%s' "$1" | tr -d '\r\n')
  [ "$clean" = "$1" ] || { echo "Newlines are not allowed in argument values" >&2; return 1; }
  if printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    echo "Control characters are not allowed in argument values" >&2
    return 1
  fi
}

validate_cli_args() {
  validate_arg_value "$1"
  case "$1" in
    *"*"*|*"?"*|*"["*|*"]"*) echo "Shell glob characters are not allowed in argument values" >&2; return 1 ;;
  esac
}

validate_value() {
  key="$1"
  value="$2"
  case "$key" in
    TS_START_ON_BOOT|TS_ENABLE_SSH|TS_WATCHDOG_ENABLED)
      case "$value" in 0|1|true|false) ;; *) echo "$key must be 0/1/true/false" >&2; return 1;; esac
    ;;
    TS_LOG_MAX_KB)
      case "$value" in ''|*[!0-9]*) echo "TS_LOG_MAX_KB must be an integer" >&2; return 1;; esac
      if [ "$value" -lt 128 ] || [ "$value" -gt 10240 ]; then
        echo "TS_LOG_MAX_KB must be between 128 and 10240" >&2
        return 1
      fi
    ;;
    TS_LOGIN_SERVER) value=$(normalize_login_server "$value") ;;
    TS_HOSTNAME)
      validate_arg_value "$value"
      case "$value" in *[!A-Za-z0-9._-]*) echo "TS_HOSTNAME contains unsupported characters" >&2; return 1;; esac
    ;;
    TS_DAEMON_ARGS|TS_UP_ARGS|TS_EXTRA_UP_ARGS) validate_cli_args "$value" ;;
  esac
  printf '%s\n' "$value"
}

assign_key() {
  case "$1" in
    TS_START_ON_BOOT) TS_START_ON_BOOT="$2" ;;
    TS_DAEMON_ARGS) TS_DAEMON_ARGS="$2" ;;
    TS_UP_ARGS) TS_UP_ARGS="$2" ;;
    TS_LOGIN_SERVER) TS_LOGIN_SERVER="$2" ;;
    TS_HOSTNAME) TS_HOSTNAME="$2" ;;
    TS_ENABLE_SSH) TS_ENABLE_SSH="$2" ;;
    TS_EXTRA_UP_ARGS) TS_EXTRA_UP_ARGS="$2" ;;
    TS_WATCHDOG_ENABLED) TS_WATCHDOG_ENABLED="$2" ;;
    TS_LOG_MAX_KB) TS_LOG_MAX_KB="$2" ;;
  esac
}

validate_current_config() {
  validate_value TS_START_ON_BOOT "${TS_START_ON_BOOT:-1}" >/dev/null
  validate_value TS_DAEMON_ARGS "${TS_DAEMON_ARGS:-}" >/dev/null
  validate_value TS_UP_ARGS "${TS_UP_ARGS:-}" >/dev/null
  validate_value TS_LOGIN_SERVER "${TS_LOGIN_SERVER:-}" >/dev/null
  validate_value TS_HOSTNAME "${TS_HOSTNAME:-}" >/dev/null
  validate_value TS_ENABLE_SSH "${TS_ENABLE_SSH:-0}" >/dev/null
  validate_value TS_EXTRA_UP_ARGS "${TS_EXTRA_UP_ARGS:-}" >/dev/null
  validate_value TS_WATCHDOG_ENABLED "${TS_WATCHDOG_ENABLED:-0}" >/dev/null
  validate_value TS_LOG_MAX_KB "${TS_LOG_MAX_KB:-1024}" >/dev/null
}

is_watchdog_pid() {
  pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'tailscaled.watchdog'
}

stop_watchdog() {
  pid_file="${TS_RUN_DIR}/watchdog.pid"
  pid=$(cat "$pid_file" 2>/dev/null || true)
  if is_watchdog_pid "$pid"; then
    kill "$pid" 2>/dev/null || true
    wait_count=0
    while is_watchdog_pid "$pid" && [ "$wait_count" -lt 20 ]; do
      sleep 0.1
      wait_count=$((wait_count + 1))
    done
    if is_watchdog_pid "$pid"; then
      kill -9 "$pid" 2>/dev/null || true
      sleep 0.1
    fi
  fi
  rm -f "$pid_file"
  owner=$(cat "${TS_RUN_DIR}/watchdog.lock/pid" 2>/dev/null || true)
  is_watchdog_pid "$owner" || rm -rf "${TS_RUN_DIR}/watchdog.lock"
}

sync_watchdog() {
  mkdir -p "${TS_RUN_DIR}"
  pid_file="${TS_RUN_DIR}/watchdog.pid"
  pid=$(cat "$pid_file" 2>/dev/null || true)
  running=0
  is_watchdog_pid "$pid" && running=1
  enabled=1
  case "${TS_WATCHDOG_ENABLED:-0}" in 1|true) ;; *) enabled=0;; esac
  case "${TS_START_ON_BOOT:-1}" in 1|true) ;; *) enabled=0;; esac
  [ -f "${TS_MOD_DIR}/disable" ] && enabled=0
  [ -f "${TS_RUN_DIR}/manual-stop" ] && enabled=0
  if [ "$enabled" -eq 0 ]; then
    stop_watchdog
    return 0
  fi
  [ "$running" -eq 1 ] && return 0
  [ -f "${TS_SCRIPTS_DIR}/tailscaled.watchdog" ] || return 0
  nohup sh "${TS_SCRIPTS_DIR}/tailscaled.watchdog" >/dev/null 2>&1 &
}

set_key() {
  key="$1"
  shift || true
  value="$*"
  validate_key "$key"
  value=$(validate_value "$key" "$value")
  assign_key "$key" "$value"
  write_config
  sync_watchdog
}

set_many() {
  [ "$(( $# % 2 ))" -eq 0 ] || { echo "usage: tailscaled.config set-many KEY VALUE ..." >&2; return 2; }
  while [ "$#" -gt 0 ]; do
    key="$1"
    value="$2"
    shift 2
    validate_key "$key"
    value=$(validate_value "$key" "$value")
    assign_key "$key" "$value"
  done
  write_config
  sync_watchdog
}

strip_login_server_args() {
  out=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --login-server)
        shift
        [ "$#" -gt 0 ] && shift
        continue
      ;;
      --login-server=*) shift; continue ;;
    esac
    out="${out}${out:+ }$1"
    shift
  done
  printf '%s\n' "$out"
}

build_up_args() {
  args="${TS_UP_ARGS:-}"
  [ -n "${TS_HOSTNAME:-}" ] && args="$args --hostname=${TS_HOSTNAME}"
  case "${TS_ENABLE_SSH:-0}" in
    1|true) case " $args " in *" --ssh "*) ;; *) args="$args --ssh";; esac ;;
  esac
  [ -n "${TS_EXTRA_UP_ARGS:-}" ] && args="$args ${TS_EXTRA_UP_ARGS}"
  if [ -n "${TS_LOGIN_SERVER:-}" ]; then
    # shellcheck disable=SC2086
    args=$(strip_login_server_args $args)
    args="${args}${args:+ }--login-server=${TS_LOGIN_SERVER}"
  fi
  printf '%s\n' "$args"
}

run_async() {
  action="$1"
  operation_id="$(date +%s)-$$-${action}"
  mkdir -p "${TS_RUN_DIR}"
  rotate_log "${TS_RUN_LOG_FILE}"
  {
    echo "=== OPERATION ${operation_id} ${action} ==="
    echo "$(date +"%I:%M %P") [Info]: Starting async tailscale ${action}; watch this log for login URLs and progress."
  } >>"${TS_RUN_LOG_FILE}" 2>/dev/null || true
  nohup sh -c "{ sh '$0' '$action'; code=\$?; echo '=== OPERATION ${operation_id} END exit='\"\$code\"' ==='; } 2>&1 | sh '$DIR/tailscaled.logwriter' '${TS_RUN_LOG_FILE}'" >/dev/null 2>&1 &
  echo "OPERATION_ID=${operation_id}"
  echo "Started tailscale ${action} in the background."
}

recent_log() {
  {
    for file in "${TS_RUN_LOG_FILE}.3" "${TS_RUN_LOG_FILE}.2" "${TS_RUN_LOG_FILE}.1" "${TS_RUN_LOG_FILE}"; do
      [ -f "$file" ] && tail -n 140 "$file"
    done
  } | tail -n 140 2>/dev/null || true
}

webui_log() {
  log=$(recent_log)
  jq -cn --arg log "$log" '{log:$log}'
}

peer_test() {
  target="$1"
  [ -n "$target" ] || { echo "peer-test requires a Tailscale IP" >&2; return 2; }
  case "$target" in *[!0-9A-Fa-f:.]*) echo "peer-test accepts only an IP address" >&2; return 2;; esac
  timeout 16 tailscale ping -c 5 --until-direct=false --timeout 2s "$target"
}

run_netcheck() {
  mkdir -p "${TS_RUN_DIR}"
  out="${TS_RUN_DIR}/netcheck.$$.json"
  err="${TS_RUN_DIR}/netcheck.$$.err"
  trap 'rm -f "$out" "$err"' EXIT INT TERM
  if ! timeout 30 tailscale netcheck --format=json >"$out" 2>"$err"; then
    cat "$err" >&2
    return 1
  fi
  jq -e . "$out" >/dev/null 2>&1 || { cat "$err" >&2; echo "tailscale netcheck returned invalid JSON" >&2; return 1; }
  warnings=$(cat "$err" 2>/dev/null || true)
  jq -cn --argjson report "$(cat "$out")" --arg warnings "$warnings" '{report:$report,warnings:$warnings}'
}

daemon_running() {
  busybox pgrep -x tailscaled >/dev/null 2>&1
}

status_json() {
  if daemon_running; then
    value=$(timeout 4 tailscale status --json 2>/dev/null || echo '{}')
    printf '%s' "$value" | jq -e . >/dev/null 2>&1 || value='{}'
    printf '%s' "$value"
  else
    printf '{}'
  fi
}

webui_snapshot() {
  daemon=stopped
  daemon_running && daemon=running
  snapshot_status_json=$(status_json)
  ip=$(printf '%s' "$snapshot_status_json" | jq -r '.Self.TailscaleIPs[0] // empty' 2>/dev/null)
  log=$(recent_log)
  config_json=$(show_json)
  jq -cn \
    --arg daemon "$daemon" \
    --arg ip "$ip" \
    --arg log "$log" \
    --argjson status "$snapshot_status_json" \
    --argjson config "$config_json" \
    '{daemon:$daemon,ip:$ip,log:$log,status:$status,config:$config}'
}

health_report() {
  daemon=false
  daemon_running && daemon=true
  health_status_json=$(status_json)
  module_version=$(awk -F= '/^version=/{print $2; exit}' "${TS_MOD_PROP}" 2>/dev/null || true)
  cli_version=$(timeout 4 tailscale version 2>/dev/null | head -n 1 || true)
  selinux=unsupported
  command -v getenforce >/dev/null 2>&1 && selinux=$(getenforce 2>/dev/null || echo unsupported)
  config_valid=false
  validate_current_config >/dev/null 2>&1 && config_valid=true
  config_readable=false
  [ -r "${TS_CONFIG_FILE}" ] && config_readable=true
  config_mode=$(stat -c %a "${TS_CONFIG_FILE}" 2>/dev/null || echo unknown)
  watchdog_running=false
  watchdog_pid=$(cat "${TS_RUN_DIR}/watchdog.pid" 2>/dev/null || true)
  is_watchdog_pid "$watchdog_pid" && watchdog_running=true
  restart_count=$(cat "${TS_RUN_DIR}/watchdog-restarts" 2>/dev/null || echo 0)
  case "$restart_count" in ''|*[!0-9]*) restart_count=0;; esac
  daemon_log_bytes=0
  run_log_bytes=0
  [ -f "${TS_LOG_FILE}" ] && daemon_log_bytes=$(wc -c <"${TS_LOG_FILE}" 2>/dev/null || echo 0)
  [ -f "${TS_RUN_LOG_FILE}" ] && run_log_bytes=$(wc -c <"${TS_RUN_LOG_FILE}" 2>/dev/null || echo 0)
  custom_login_server=false
  [ -n "${TS_LOGIN_SERVER:-}" ] && custom_login_server=true
  disable_dns=false
  case " ${TS_UP_ARGS:-} ${TS_EXTRA_UP_ARGS:-} " in *" --accept-dns=false "*) disable_dns=true;; esac
  jq -cn \
    --arg moduleVersion "$module_version" \
    --arg cliVersion "$cli_version" \
    --arg daemon "$daemon" \
    --argjson status "$health_status_json" \
    --arg selinux "$selinux" \
    --arg configValid "$config_valid" \
    --arg configReadable "$config_readable" \
    --arg configMode "$config_mode" \
    --arg watchdogEnabled "${TS_WATCHDOG_ENABLED:-0}" \
    --arg watchdogRunning "$watchdog_running" \
    --arg restartCount "$restart_count" \
    --arg daemonLogBytes "$daemon_log_bytes" \
    --arg runLogBytes "$run_log_bytes" \
    --arg customLoginServer "$custom_login_server" \
    --arg disableDns "$disable_dns" \
    '{moduleVersion:$moduleVersion,cliVersion:$cliVersion,daemonRunning:($daemon=="true"),backend:($status.BackendState//"Unknown"),tun:($status.TUN//false),health:($status.Health//[]),selinux:$selinux,config:{valid:($configValid=="true"),readable:($configReadable=="true"),mode:$configMode,customLoginServer:($customLoginServer=="true"),disableDns:($disableDns=="true")},watchdog:{enabled:($watchdogEnabled=="1" or $watchdogEnabled=="true"),running:($watchdogRunning=="true"),restarts:($restartCount|tonumber)},logs:{daemonBytes:($daemonLogBytes|tonumber),runBytes:($runLogBytes|tonumber)}}'
}

case "${1:-get}" in
  get|json) show_json ;;
  webui) webui_snapshot ;;
  webui-log) webui_log ;;
  health) health_report ;;
  peer-test) shift; [ "$#" -eq 1 ] || { echo "usage: tailscaled.config peer-test IP" >&2; exit 2; }; peer_test "$1" ;;
  netcheck) run_netcheck ;;
  validate) validate_current_config ;;
  migrate) validate_current_config; write_config ;;
  watchdog-sync) sync_watchdog ;;
  init) write_config ;;
  set) shift; [ "$#" -ge 2 ] || { echo "usage: tailscaled.config set KEY VALUE" >&2; exit 2; }; key="$1"; shift; set_key "$key" "$@" ;;
  set-many) shift; set_many "$@" ;;
  up) # shellcheck disable=SC2086,SC2046
    tailscale up $(build_up_args)
  ;;
  up-bg) run_async up ;;
  down) tailscale down ;;
  login) if [ -n "${TS_LOGIN_SERVER:-}" ]; then tailscale login --login-server="${TS_LOGIN_SERVER}"; else tailscale login; fi ;;
  login-bg) run_async login ;;
  logout) tailscale logout ;;
  restart) tailscaled.service restart ;;
  cmdline) printf '%s\n' "${TS_DAEMON_CMD}" ;;
  up-args) build_up_args ;;
  *) echo "usage: tailscaled.config {get|webui|webui-log|health|peer-test IP|netcheck|validate|migrate|watchdog-sync|set KEY VALUE|set-many KEY VALUE ...|init|up|up-bg|down|login|login-bg|logout|restart|cmdline|up-args}" >&2; exit 2 ;;
esac
