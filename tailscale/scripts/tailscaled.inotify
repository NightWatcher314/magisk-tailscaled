#!/system/bin/sh
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=tailscale/settings.sh
. "$DIR"/../settings.sh

events="$1"
# monitor_dir="$2"
monitor_file="$3"

service_control() {
  if [ "${monitor_file}" = "disable" ]; then
    if [ "${events}" = "d" ]; then
      log Info "Module enabled; evaluating tailscaled autostart."
      case "${TS_START_ON_BOOT:-1}" in 1|true) tailscaled.service start >>"${TS_RUN_LOG_FILE}" 2>&1;; esac
      tailscaled.config watchdog-sync >/dev/null 2>&1 || true
    elif [ "${events}" = "n" ]; then
      log Info "Module disabled; stopping tailscaled service."
      tailscaled.service stop >>"${TS_RUN_LOG_FILE}" 2>&1
      tailscaled.config watchdog-sync >/dev/null 2>&1 || true
    fi
  fi
}
service_control
